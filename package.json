{
  "name": "chess-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "online-chess/server",
    "online-chess/client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=online-chess/server",
    "dev:client": "npm run dev --workspace=online-chess/client",
